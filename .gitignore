# The dashboard lives here too, under dashboard/ — it has its own .gitignore
# for build output. It used to be a separate repository; its history was
# imported as a subtree on 2026-08-08.

# Claude Code local config
.claude/

# Credentials / signing secrets — never commit these anywhere in the tree
*.p8
*.p12
*.key
*.keystore
*.jks
*.mobileprovision
.env
.env.*
!.env.example
