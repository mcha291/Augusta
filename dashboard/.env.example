# Copy to .env.local for local development.
#
# Option 1 — UI development without AWS (mock data):
VITE_MOCK=1

# Option 2 — against the real admin API (fill in after AWS-SETUP.md):
# VITE_MOCK=0
# VITE_COGNITO_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<admin-pool-id>
# VITE_COGNITO_CLIENT_ID=<admin-app-client-id>
# VITE_COGNITO_DOMAIN=https://<your-prefix>.auth.<region>.amazoncognito.com
# VITE_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com

# --- Metabase (TELEMETRY.md §4) --------------------------------------------
# Its base URL. Powers the "Open Metabase" link on the Analytics page, which
# goes to Metabase's own login — it keeps separate accounts, and Cognito SSO is
# a paid feature.
# VITE_METABASE_URL=https://bi.ti-smarthealth.com
#
# Optional: a SIGNED STATIC EMBED URL for one dashboard, not the base URL above.
# The Metabase app sends X-Frame-Options: DENY, so only /embed/* routes can be
# framed and the login page never can. Needs Admin -> Embedding enabled first,
# and Metabase must be HTTPS or the browser blocks it as mixed content.
# VITE_METABASE_EMBED_URL=https://bi.ti-smarthealth.com/embed/dashboard/<jwt>#bordered=false&titled=false
