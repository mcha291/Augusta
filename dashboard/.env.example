# Copy to .env.local for local development.
#
# Option 1 — UI development without AWS (mock data):
VITE_MOCK=1

# Option 2 — against the real admin API (fill in after AWS-SETUP.md):
# VITE_MOCK=0
# VITE_COGNITO_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<admin-pool-id>
# VITE_COGNITO_CLIENT_ID=<admin-app-client-id>
# VITE_COGNITO_DOMAIN=https://<your-prefix>.auth.<region>.amazoncognito.com
# VITE_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com
