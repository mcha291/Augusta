#!/bin/sh
# Committed pre-commit hook (enable once per clone):
#   git config core.hooksPath .githooks
# Runs the admin Lambda's functional tests when server files are staged.

if git diff --cached --name-only | grep -q '^server/'; then
  echo "pre-commit: server files staged - running admin Lambda tests..."
  npm --prefix server test || {
    echo "pre-commit: tests failed - commit aborted."
    exit 1
  }
fi
